<SHA256>5cb005ab8a3bc1039606cc4065a3d18bd10e2f7b3d43ad78bb99bd50a0f5fb59</SHA256>
</FILE>
<FILE Run="/bin/bash"><INLINE><![CDATA[
set -eu
[ "$(uname -m)" = x86_64 ] || { echo 'Nebula plugin requires x86_64 Unraid.'; exit 1; }
root=/usr/local/emhttp/plugins/nebula
library=/usr/local/lib/nebula
state=/boot/config/plugins/nebula
mkdir -p "$state" /run/nebula
chmod 700 /run/nebula
staging=$(mktemp -d /tmp/nebula-package.XXXXXX)
trap 'rm -rf -- "$staging"' EXIT
package="$state/nebula-unraid-2026.10.23p-noarch-1.txz"
tar -xJf "$package" -C "$staging"
candidate="$staging/usr/local/lib/nebula"
web="$staging/usr/local/emhttp/plugins/nebula"
mkdir -p "$candidate/bin"
tar -xzf "$state/nebula-linux-amd64-1.12.0.tar.gz" -C "$candidate/bin" nebula nebula-cert
install -m 755 "$state/yq-linux-amd64-4.54.1" "$candidate/bin/yq"
chmod 755 "$candidate/bin/nebula" "$candidate/bin/nebula-cert"
# Check the candidate independently of the saved profile's certificate validity.
"$candidate/bin/nebula" -version
"$candidate/bin/nebula-cert" -version
"$candidate/bin/yq" --version
for file in "$candidate/src/"*.php "$web/"*.php "$web/include/"*.php "$web/"*.page "$web/scripts/config" "$web/scripts/watch" "$web/scripts/health"; do
    php -l "$file" >/dev/null
done
was_running=false
if [ -x /etc/rc.d/rc.nebula ]; then
    if /etc/rc.d/rc.nebula status; then was_running=true; fi
    /etc/rc.d/rc.nebula stop --no-refresh
fi
upgradepkg --install-new --reinstall "$package"
mkdir -p "$library/bin"
install -m 755 "$candidate/bin/nebula" "$candidate/bin/nebula-cert" "$candidate/bin/yq" "$library/bin/"
rm -f /run/nebula/service-addresses
echo 'profile.json' > "$state/.gitignore"
if $was_running; then action=start; else action=autostart; fi
if ! /etc/rc.d/rc.nebula "$action"; then
    echo 'Nebula installed; startup failed. Check Settings > Nebula.'
    "$root/scripts/health" startup || true
fi
echo 'Nebula installed. Open Settings > Network Services > Nebula.'
]]></INLINE></FILE>
<FILE Run="/bin/bash" Method="remove"><INLINE><![CDATA[
set -eu
if [ -x /etc/rc.d/rc.nebula ]; then /etc/rc.d/rc.nebula stop --no-refresh; fi
if [ -x /usr/local/emhttp/plugins/nebula/scripts/watch ]; then
    /usr/local/emhttp/plugins/nebula/scripts/watch remove
fi
removepkg nebula-unraid
# Upstream binaries are installed separately from the noarch package.
rm -rf /usr/local/emhttp/plugins/nebula /usr/local/lib/nebula /run/nebula
echo 'Nebula removed. Saved profiles remain in /boot/config/plugins/nebula.'
]]></INLINE></FILE>
</PLUGIN>
